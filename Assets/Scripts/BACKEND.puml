@startuml BACKEND

skinparam classAttributeIconSize 0
skinparam classFontName Courier
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #D8D8F0
skinparam classBorderColor #333333
skinparam classBackgroundColor #FFFFFF
skinparam interfaceBackgroundColor #E8F4E8
skinparam interfaceBorderColor #336633
skinparam arrowColor #333333
skinparam arrowThickness 1.5
skinparam linetype ortho

title Backend — Factory Game UML (Unity)

note as N1
  <b>Pure C#</b>: EventBus, GameEvent 계열, 인터페이스
  <b>MonoBehaviour</b>: Item 계열, Machine 계열, BeltTrack,
  ItemSpawner, SellManager, RoundManager, GameManager, FactoryStatus
  <b>브리지</b>: IFactoryStatusSubject, IRoundSubject,
  IBeltTrackLevelSubject, ISellBlockObserver 등은
  FrontEnd/ObserverPattern/ 에 정의됨 — FRONTEND.puml 참고
end note

' ══════════════════════════════════════════════
' INTERFACES (Backend)
' ══════════════════════════════════════════════

interface IGameEventListener {
  +OnEvent(e: GameEvent): void
}

interface IManager {
  +OnEvent(e: GameEvent): void
}

interface IUpgradable {
  +Upgrade(stat: StatType, amount: float): void
  +GetStats(): Stat
}

interface ISellable {
  +CalculatePrice(spMult: float): float
  +IsDefective: bool <<get>>
  +SellItem(): void
}

' ══════════════════════════════════════════════
' ENUMS
' ══════════════════════════════════════════════

enum StatType {
  AttackPower
  Durability
  Splendor
}

enum MachineType {
  Grinder
  Welder
  Painter
}

enum EventType {
  None
  Boom
  Recession
}

enum FactoryStatusType {
  Money
  BrandLevel
  BrandPoints
  BankruptcyBar
}

enum Operation {
  Addition
  Multiplication
  Assignment
}

' ══════════════════════════════════════════════
' EVENTS  (Pure C#)
' ══════════════════════════════════════════════

abstract class GameEvent {
  +Timestamp: float <<get>>
}

class RoundEndEvent {
  +AvgAP: float <<get>>
  +Passed: bool <<get>>
}

class ItemSoldEvent {
  +Price: float <<get>>
  +IsDefective: bool <<get>>
  +Stats: Stat <<get>>
}

class MarketEvent {
  +EventType: EventType <<get>>
}

class BankruptcyEvent {
  +BarLevel: float <<get>>
}

GameEvent <|-- RoundEndEvent
GameEvent <|-- ItemSoldEvent
GameEvent <|-- MarketEvent
GameEvent <|-- BankruptcyEvent

' ══════════════════════════════════════════════
' EVENT BUS  (Pure C# singleton)
' ══════════════════════════════════════════════

class EventBus << (S,#FFD700) singleton >> {
  -_instance: EventBus {static}
  -_listeners: List~IGameEventListener~
  --
  +GetInstance(): EventBus {static}
  +Subscribe(l: IGameEventListener): void
  +Unsubscribe(l: IGameEventListener): void
  +Publish(e: GameEvent): void
}

EventBus "1" o-- "0..*" IGameEventListener : _listeners
EventBus ..> GameEvent : dispatches

' ══════════════════════════════════════════════
' STAT  (Pure C#, [Serializable])
' ══════════════════════════════════════════════

class Stat {
  -_entries: List~StatEntry~ <<SerializeField>>
  -_values: Dict~StatType, float~
  --
  +Get(type: StatType): float
  +Set(type: StatType, value: float): void
  +Add(type: StatType, amount: float): void
  +Clone(): Stat
}

class StatEntry << struct >> {
  -_type: StatType <<SerializeField>>
  -_value: float <<SerializeField>>
  --
  +Type: StatType <<get>>
  +Value: float <<get>>
}

Stat "1" *-- "0..*" StatEntry : _entries (직렬화용)
Stat ..> StatType

note bottom of Stat
  스탯 추가 = StatType enum 멤버 추가
  + Item.PriceCoefficients 계수 등록만으로 끝 (OCP).
  인스펙터에는 StatEntry 리스트로 노출,
  런타임은 Dictionary로 동작 (ISerializationCallbackReceiver)
end note

' ══════════════════════════════════════════════
' ITEM  (MonoBehaviour — 프리팹에 부착)
' ══════════════════════════════════════════════

abstract class Item << MonoBehaviour >> {
  -PriceCoefficients: Dict~StatType, float~ {static}
  -_stats: Stat
  -_isDefective: bool
  -_position: Vector3
  --
  +IsDefective: bool <<get, protected set>>
  +Position: Vector3 <<get, set>>
  --
  +Initialize(stats: Stat): void
  +MoveItem(dp: Vector3): void
  +Upgrade(stat: StatType, amount: float): void
  +GetStats(): Stat
  +CalculatePrice(spMult: float): float
  +CalculateDefectChance(): float
  +MakeDefective(): void
  +SellItem(): void
}

class StandardItem << MonoBehaviour >> {
}

Item <|-- StandardItem
Item ..|> IUpgradable
Item ..|> ISellable
Item "1" *-- "1" Stat : _stats

' ══════════════════════════════════════════════
' MACHINE  (MonoBehaviour)
' ══════════════════════════════════════════════

abstract class Machine << MonoBehaviour >> {
  -_beltTrack: BeltTrack <<SerializeField>>
  -_upgradeInterval: float <<SerializeField>>
  -_level: int
  -_cooldown: float
  -_upgradeAmount: float
  -_type: MachineType
  --
  +Level: int <<get, private set>>
  +UpgradeInterval: float <<get, private set>>
  +UpgradeAmount: float <<get, private set>>
  +InstallPrice: float <<get>> {static}
  +LevelUpPriceCoeff: float <<get>> {static}
  --
  +Configure(beltTrack: BeltTrack): void
  +LevelUp(): void
  +GetMachineType(): MachineType
  #SetMachineType(type: MachineType): void
  -UpgradeItem(item: Item): void
  -OnTriggerStay(other: Collider): void
  +{abstract} GetTargetStat(): StatType
  +{abstract} CanCauseDefect(): bool
}

note bottom of Machine
  가공 경로 2가지: Update()의 GetNearestItem 추적
  + OnTriggerStay() 물리 충돌. 가공 시 alphaEff
  코루틴으로 투명도 연출
end note

class Grinder << MonoBehaviour >> {
  +GetTargetStat(): StatType
  +CanCauseDefect(): bool
}
note right of Grinder : AttackPower 강화, 불량 유발 가능

class Welder << MonoBehaviour >> {
  +GetTargetStat(): StatType
  +CanCauseDefect(): bool
}
note right of Welder : Durability 강화, 불량 없음

class Painter << MonoBehaviour >> {
  +GetTargetStat(): StatType
  +CanCauseDefect(): bool
}
note right of Painter : Splendor 강화, 불량 유발 가능

Machine <|-- Grinder
Machine <|-- Welder
Machine <|-- Painter
Machine ..> Item : upgrades

' ══════════════════════════════════════════════
' BELT TRACK  (MonoBehaviour)
' ══════════════════════════════════════════════

class BeltTrack << MonoBehaviour >> {
  -_sellManager: SellManager <<SerializeField>>
  -_trackLength: float <<SerializeField>>
  -_sellBlock: BlockBase <<SerializeField>>
  -_level: int
  -_machineSpaces: int
  -_speed: Vector3
  -_items: List~Item~
  -_itemPositions: Dict~Item, float~
  -_observers: List~IObserver~
  --
  +Level: int <<get, private set>>
  +MachineSpaces: int <<get, private set>>
  +Speed: Vector3 <<get, private set>>
  +TrackLength: float <<get, private set>>
  +LevelUpPrice: float <<get>>
  --
  +AddItem(item: Item): void
  +RemoveItem(item: Item): void
  +GetNearestItem(xPosition: float): Item
  +LevelUp(): void
  +GetMachineSpaces(): int
  +NotifyBeltTrackLevel(): void
  +OnSellBlockReached(item: ISellable): void
}

note bottom of BeltTrack
  IBeltTrackLevelSubject + ISellBlockObserver 구현 (FRONTEND.puml).
  _sellBlock(FrontEnd BlockBase)을 직접 참조하고
  Start()에서 SellManager.Instance를 사용 — DESIGN.md
  "알려진 어긋남" 참고
end note

BeltTrack "1" *-- "0..*" Item : _items
BeltTrack "1" o-- "1" SellManager : _sellManager

' ══════════════════════════════════════════════
' ITEM SPAWNER  (MonoBehaviour)
' ══════════════════════════════════════════════

class ItemSpawner << MonoBehaviour >> {
  -_beltTrack: BeltTrack <<SerializeField>>
  -_itemPrefab: GameObject <<SerializeField>>
  -_baseStat: Stat <<SerializeField>>
  -_spawnInterval: float <<SerializeField>>
  -_timer: float
  -_level: int
  --
  +BaseStat: Stat <<get, private set>>
  +SpawnInterval: float <<get, private set>>
  --
  +ShouldSpawn(): bool
  +SpawnItem(): void
  +LevelUp(): void
  +OnBeltTrackLevelChanged(s: IBeltTrackLevelSubject): void
}

ItemSpawner "1" o-- "1" BeltTrack : _beltTrack
ItemSpawner "1" *-- "1" Stat : _baseStat
ItemSpawner ..> Item : instantiates prefab + Initialize(baseStat.Clone())

' ══════════════════════════════════════════════
' FACTORY STATUS  (MonoBehaviour singleton)
' ══════════════════════════════════════════════

class FactoryStatus << (S,#FFD700) MonoBehaviour singleton >> {
  -_instance: FactoryStatus {static}
  -_factoryStatusValue: Dict~FactoryStatusType, float~
  -_observers: List~IObserver~
  --
  +Money: float <<get>>
  +BrandLevel: float <<get>>
  +BrandPoints: float <<get>>
  +SplendorMultiplier: float <<get>>
  +BankruptcyBar: float <<get>>
  --
  +GetInstance(): FactoryStatus {static}
  +Threshold(): float
  +ModifyMoney(v: float): void
  +AddBrandPoints(sp: float): void
  +UpdateBankruptcyBar(delta: float): void
  +IsGameOver(): bool
  +ResetStatus(): void
  +NotifyFactoryStatus(type: FactoryStatusType, arg: UIUpdateArgs): void
}

note bottom of FactoryStatus
  IFactoryStatusSubject 구현 (FRONTEND.puml).
  Update()에서 파산바 자연 가감:
  돈이 음수면 -Money/2000*dt 가산, 양수면 dt/60 감소
end note

' ══════════════════════════════════════════════
' ROUND MANAGER  (MonoBehaviour + IManager)
' ══════════════════════════════════════════════

class RoundManager << (S,#FFD700) MonoBehaviour singleton >> {
  -instance: RoundManager {static}
  -_roundNumber: int
  -_apThreshold: float
  -_checkInterval: float
  -_bonus: float
  -_penalty: float
  -_soldItemAPs: List~float~
  -_observers: List~IObserver~
  --
  +Instance: RoundManager <<get>> {static}
  +RoundNumber: int <<get, private set>>
  +ApThreshold: float <<get, private set>>
  +CheckInterval: float <<get, private set>>
  +Bonus: float <<get, private set>>
  +Penalty: float <<get, private set>>
  +AverageAP: float <<get>>
  --
  +OnEvent(e: GameEvent): void
  +StartRound(): void
  -EndRound(): void
  +ScaleNextRound(): void
  +NotifyRound(): void
}

RoundManager ..|> IManager
RoundManager ..|> IGameEventListener
RoundManager ..> EventBus : Subscribe / Publish(RoundEndEvent)
RoundManager ..> FactoryStatus : ModifyMoney

' ══════════════════════════════════════════════
' SELL MANAGER  (MonoBehaviour + IManager)
' ══════════════════════════════════════════════

class SellManager << (S,#FFD700) MonoBehaviour singleton >> {
  -_instance: SellManager {static}
  -_apMultiplier: float
  -_spMultiplier: float
  -_activeEvent: EventType
  --
  +Instance: SellManager <<get>> {static}
  +ApMultiplier: float <<get, set>>
  +SpMultiplier: float <<get, set>>
  +ActiveEvent: EventType <<get, private set>>
  --
  +OnEvent(e: GameEvent): void
  +SellItem(item: ISellable): void
  +ApplyFine(item: ISellable, p: float): void
}

SellManager ..|> IManager
SellManager ..|> IGameEventListener
SellManager ..> EventBus : Subscribe / Publish(ItemSoldEvent)
SellManager ..> FactoryStatus : ModifyMoney / AddBrandPoints
SellManager ..> ISellable : <<use>> param

' ══════════════════════════════════════════════
' GAME MANAGER  (MonoBehaviour)
' ══════════════════════════════════════════════

class GameManager << MonoBehaviour >> {
  -_beltTrack: BeltTrack <<SerializeField>>
  -_itemSpawner: ItemSpawner <<SerializeField>>
  -_grinderPrefab: GameObject <<SerializeField>>
  -_welderPrefab: GameObject <<SerializeField>>
  -_painterPrefab: GameObject <<SerializeField>>
  -_managers: List~IManager~
  -_placedMachines: List~Machine~
  --
  +OnEvent(e: GameEvent): void
  +StartGame(): void
  +PauseGame(): void
  +ResetGame(): void
  +PlaceMachine(type: MachineType, pos: int): void
  +LevelUpMachine(pos: int): void
  +RemoveMachine(pos: int): void
  +LevelUpBelt(): void
}

GameManager ..|> IGameEventListener
GameManager ..> EventBus : Subscribe
GameManager ..> FactoryStatus : IsGameOver / ResetStatus
GameManager "1" o-- "1"    BeltTrack   : _beltTrack
GameManager "1" o-- "1"    ItemSpawner : _itemSpawner
GameManager "1" o-- "0..*" IManager    : _managers
GameManager "1" o-- "0..*" Machine     : _placedMachines

@enduml
