@startuml BACKEND

skinparam classAttributeIconSize 0
skinparam classFontName Courier
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #D8D8F0
skinparam classBorderColor #333333
skinparam classBackgroundColor #FFFFFF
skinparam interfaceBackgroundColor #E8F4E8
skinparam interfaceBorderColor #336633
skinparam arrowColor #333333
skinparam arrowThickness 1.5

title Backend — Factory Game UML (Unity)

note as N1
  <b>Pure C#</b>: EventBus, GameEvent family, interfaces
  <b>MonoBehaviour</b>: Item family, Machine family, BeltTrack,
  ItemSpawner, SellManager, RoundManager, GameManager, FactoryStatus
  <b>Bridge</b>: IFactoryStatusSubject, IRoundSubject,
  IBeltTrackLevelSubject, ISellBlockObserver etc. are defined in
  FrontEnd/ObserverPattern/ — see FRONTEND_VIEW.puml
end note

' ══════════════════════════════════════════════
' INTERFACES (Backend)
' ══════════════════════════════════════════════

interface IGameEventListener {
  +OnEvent(e: GameEvent): void
}

interface IGameState {
  +Enter(): void
  +Update(): void
  +Exit(): void
}

interface IUpgradable {
  +Upgrade(stat: StatType, amount: float): void
  +GetStats(): Stat
}

interface ISellable {
  +CalculatePrice(spMult: float): float
  +IsDefective: bool <<get>>
  +SellItem(): void
}

' ══════════════════════════════════════════════
' ENUMS
' ══════════════════════════════════════════════

enum StatType {
  AttackPower
  Durability
  Splendor
}

enum MachineType {
  Grinder
  Welder
  Painter
}

enum EventType {
  None
  Boom
  Recession
}

enum FactoryStatusType {
  Money
  BrandLevel
  BrandPoints
  BankruptcyBar
}

enum Operation {
  Addition
  Multiplication
  Assignment
}
note bottom of Operation : currently unused — FactoryStatus.SetValue\nwas removed in favor of direct property + Notify

' ══════════════════════════════════════════════
' EVENTS  (Pure C#)
' ══════════════════════════════════════════════

abstract class GameEvent {
  +Timestamp: float <<get>>
}

class RoundEndEvent {
  +AvgAP: float <<get>>
  +Passed: bool <<get>>
}

class ItemSoldEvent {
  +Price: float <<get>>
  +IsDefective: bool <<get>>
  +Stats: Stat <<get>>
}

class MarketEvent {
  +EventType: EventType <<get>>
}

class BankruptcyEvent {
  +BarLevel: float <<get>>
}

GameEvent <|-- RoundEndEvent
GameEvent <|-- ItemSoldEvent
GameEvent <|-- MarketEvent
GameEvent <|-- BankruptcyEvent

' ══════════════════════════════════════════════
' EVENT BUS  (Pure C# singleton)
' ══════════════════════════════════════════════

class EventBus << (S,#FFD700) singleton >> {
  -_instance: EventBus {static}
  -_listeners: List~IGameEventListener~
  --
  +GetInstance(): EventBus {static}
  +Subscribe(l: IGameEventListener): void
  +Unsubscribe(l: IGameEventListener): void
  +Publish(e: GameEvent): void
}

EventBus "1" o-- "0..*" IGameEventListener : _listeners
EventBus ..> GameEvent : dispatches

' ══════════════════════════════════════════════
' STAT  (Pure C#, [Serializable])
' ══════════════════════════════════════════════

class Stat {
  -_entries: List~StatEntry~ <<SerializeField>>
  -_values: Dict~StatType, float~
  --
  +Get(type: StatType): float
  +Set(type: StatType, value: float): void
  +Add(type: StatType, amount: float): void
  +Clone(): Stat
}

class StatEntry << struct >> {
  -_type: StatType <<SerializeField>>
  -_value: float <<SerializeField>>
  --
  +Type: StatType <<get>>
  +Value: float <<get>>
}

Stat "1" *-- "0..*" StatEntry : _entries (serialization)
Stat ..> StatType

note bottom of Stat
  Adding a stat = add a StatType enum member
  + register a coefficient in Item.PriceCoefficients (OCP).
  Exposed to the inspector as a StatEntry list,
  runs on a Dictionary at runtime (ISerializationCallbackReceiver)
end note

' ══════════════════════════════════════════════
' ITEM  (MonoBehaviour — attached to prefab)
' ══════════════════════════════════════════════

abstract class Item << MonoBehaviour >> {
  -PriceCoefficients: Dict~StatType, float~ {static}
  -_stats: Stat
  -_isDefective: bool
  -_position: Vector3
  --
  +IsDefective: bool <<get, protected set>>
  +Position: Vector3 <<get, set>>
  --
  +Initialize(stats: Stat): void
  +MoveItem(dp: Vector3): void
  +Upgrade(stat: StatType, amount: float): void
  +GetStats(): Stat
  +CalculatePrice(spMult: float): float
  +CalculateDefectChance(): float
  +MakeDefective(): void
  +SellItem(): void
}

class StandardItem << MonoBehaviour >> {
}

Item <|-- StandardItem
Item ..|> IUpgradable
Item ..|> ISellable
Item "1" *-- "1" Stat : _stats

' ══════════════════════════════════════════════
' MACHINE  (MonoBehaviour)
' ══════════════════════════════════════════════

abstract class Machine << MonoBehaviour >> {
  -_upgradeInterval: float <<SerializeField>>
  -_maxHp: float <<SerializeField>>
  -_hpLossRate: float <<SerializeField>>
  -_minUpgradableHp: float <<SerializeField>>
  -_level: int
  -_cooldown: float
  -_upgradeAmount: float
  -_hp: float
  -_type: MachineType
  -_observers: List~IObserver~
  --
  +Level: int <<get, private set>>
  +UpgradeInterval: float <<get, private set>>
  +UpgradeAmount: float <<get, private set>>
  +Hp: float <<get, private set>>
  +MaxHp: float <<get, private set>>
  +HpRatio: float <<get>>
  +LevelUpPrice: float <<get>>
  +InstallPrice: float <<get>> {static}
  +LevelUpPriceCoeff: float <<get>> {static}
  +RepairPrice: float <<get>> {static}
  --
  +CanLevelUp(): bool
  +CanRepair(): bool
  +LevelUp(): void
  +Repair(): void
  +GetMachineType(): MachineType
  #SetMachineType(type: MachineType): void
  -UpgradeItem(item: Item): void
  -OnTriggerStay(other: Collider): void
  +RegisterObserver(o: IObserver): void
  +UnregisterObserver(o: IObserver): void
  +NotifyObservers(): void
  +NotifyMachine(): void
  +{abstract} GetTargetStat(): StatType
  +{abstract} CanCauseDefect(): bool
}

note bottom of Machine
  Implements IMachineSubject (defined in FrontEnd/ObserverPattern,
  FRONTEND_VIEW.puml); NotifyMachine() pushes OnMachineChanged to
  observers (MachineModifyUI) on wear / level-up / repair.
  HP: initialized to _maxHp in Awake (subclasses call base.Awake).
  Each item processed in UpgradeItem() wears HP by
  _maxHp * _hpLossRate * (5 - _level) (higher level wears less);
  OnTriggerStay machining runs only while _hp > 0. LevelUp() leaves
  HP alone and is gated by CanLevelUp() (_hp >= _minUpgradableHp).
  Repair() restores _hp to _maxHp, gated by CanRepair() (_hp < _maxHp).
end note

class Grinder << MonoBehaviour >> {
  +GetTargetStat(): StatType
  +CanCauseDefect(): bool
}
note right of Grinder : boosts AttackPower, may cause defects

class Welder << MonoBehaviour >> {
  +GetTargetStat(): StatType
  +CanCauseDefect(): bool
}
note right of Welder : boosts Durability, no defects

class Painter << MonoBehaviour >> {
  +GetTargetStat(): StatType
  +CanCauseDefect(): bool
}
note right of Painter : boosts Splendor, may cause defects

Machine <|-- Grinder
Machine <|-- Welder
Machine <|-- Painter
Machine ..> Item : upgrades

' ══════════════════════════════════════════════
' MACHINE COMMANDS  (Pure C# — Command.cs)
' ══════════════════════════════════════════════

interface IMachineCommand {
  +CommandName: string <<get>>
  +GetPrice(machine: Machine): float
  +CanExecute(machine: Machine): bool
  +Execute(machine: Machine): void
}

class LevelUpCommand {
  +CommandName: string <<get>>
}
class RepairCommand {
  +CommandName: string <<get>>
}

IMachineCommand <|.. LevelUpCommand
IMachineCommand <|.. RepairCommand
IMachineCommand ..> Machine : GetPrice / CanExecute / Execute

note bottom of IMachineCommand
  Machine actions (level-up, repair) as commands.
  BeltBlock.ExecuteCommand runs the common path
  (CanExecute -> PayMoney(GetPrice) -> Execute);
  MachineModifyUI holds one command per button.
end note

' ══════════════════════════════════════════════
' BELT TRACK  (MonoBehaviour)
' ══════════════════════════════════════════════

class BeltTrack << MonoBehaviour >> {
  -_sellManager: SellManager <<SerializeField>>
  -_tileCount: int <<SerializeField>>
  -_tileSize: float <<SerializeField>>
  -_sellBlock: BlockBase <<SerializeField>>
  -_level: int
  -_speed: Vector3
  -_items: List~Item~
  -_observers: List~IObserver~
  --
  +Level: int <<get, private set>>
  +TileCount: int <<get, private set>>
  +TileSize: float <<get, private set>>
  +MachineSpaces: int <<get>>
  +Speed: Vector3 <<get, private set>>
  +TrackLength: float <<get>>
  +LevelUpPrice: float <<get>>
  --
  +AddItem(item: Item): void
  +RemoveItem(item: Item): void
  +LevelUp(): void
  +NotifyBeltTrackLevel(): void
  +OnSellBlockReached(item: ISellable): void
}

note bottom of BeltTrack
  Implements IBeltTrackLevelSubject + ISellBlockObserver (FRONTEND_VIEW.puml).
  Tile-based: TrackLength = _tileCount x _tileSize,
  MachineSpaces = _tileCount, level up = +1 tile
  (one extra sell tile sits at the end of the track).
  Directly references _sellBlock (FrontEnd BlockBase) and
  uses SellManager.Instance in Start() — see DESIGN.md
  "known misalignments"
end note

BeltTrack "1" *-- "0..*" Item : _items
BeltTrack "1" o-- "1" SellManager : _sellManager

' ══════════════════════════════════════════════
' ITEM SPAWNER  (MonoBehaviour)
' ══════════════════════════════════════════════

class ItemSpawner << MonoBehaviour >> {
